                email.setSubject('Weather Report');
                email.setPlainTextBody(weatherReport);
                emailMessages.add(email);
            }
            Messaging.sendEmail(emailMessages);
            system.debug('testemails'+emailMessages);

            // Update Last_Weather_Report_Sent__c field
            if (accountId != null) {
                Account account = [SELECT Id, Last_Weather_Report__c FROM Account WHERE Id = :accountId LIMIT 1];
                account.Last_Weather_Report__c = DateTime.now();
                update account;
            }
        } catch (Exception ex) {
            throw new AuraHandledException('Error sending report: ' + ex.getMessage());
        }
    }

