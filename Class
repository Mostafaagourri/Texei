     public static void sendWeatherReport(String weatherReport, Id accountId) {
         system.debug('tetetetetetet');
        try {
            // Fetch Account-related contacts
            List<Contact> contacts = [SELECT Email FROM Contact WHERE AccountId = :accountId AND Email != NULL];
            system.debug('emailscontacts'+contacts);
